# Cloud Run runtime configuration. Store secret values in Secret Manager; do not commit a real .env file.
PORT=8080

# Supabase PostgreSQL runtime connection (TLS required). Use the session pooler or
# direct connection when Cloud Run has IPv6 connectivity; use Supavisor transaction
# pooler if required by your network, and follow its connection-string guidance.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<supabase-host>:5432/postgres?sslmode=require"
DB_POOL_MIN_SIZE="1"
DB_POOL_MAX_SIZE="5"

# Model artifact included in the container image, unless MODEL_DIR is changed at deployment time.
MODEL_DIR="./models"

# Optional API endpoint (currently unused by the ML service).
NODE_API_URL=""

# API calls are server-to-server. Keep browser CORS disabled unless a browser
# client is deliberately introduced; if so, list exact origins separated by ';'.
ML_CORS_ORIGINS=""
