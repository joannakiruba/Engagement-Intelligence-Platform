# Cloud Run runtime configuration. Store secret values in Secret Manager; do not commit a real .env file.
NODE_ENV=production
PORT=8080

# Supabase PostgreSQL runtime connection (TLS required). Use the session pooler or
# direct connection when Cloud Run has IPv6 connectivity; use Supavisor transaction
# pooler if required by your network, and follow its connection-string guidance.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@<supabase-host>:5432/postgres?sslmode=require&schema=public"

# Authentication secrets
JWT_SECRET="<secret-manager:jwt-secret>"
TOKEN_HASH_SECRET="<secret-manager:token-hash-secret>"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY_DAYS="7"
JWT_REFRESH_ABSOLUTE_CEILING_DAYS="30"
JWT_REFRESH_GRACE_WINDOW_SECONDS="10"

# Firebase Hosting URL used for CORS and account-email links.
FRONTEND_URL="https://<firebase-project>.web.app"
FRONTEND_URLS="https://<firebase-project>.web.app;https://<custom-domain>"

# Managed Redis endpoint for queues, workers, and attendance cache. Use rediss://
# when in-transit TLS is enabled; otherwise use redis:// over private VPC networking.
REDIS_URL="rediss://:<redis-password>@<redis-host>:6379/0"

# Worker service: deploy separately using `npm run start:worker`.
# Keep the service private; grant Cloud Run Invoker only to Cloud Scheduler's service account.
# Start with Cloud Run min-instances=1 and max-instances=1; adjust after observing backlog.

# Create Cloud Scheduler jobs targeting the worker service with OIDC authentication:
# POST /internal/scheduler/weekly-reports (Monday 09:00 Asia/Kolkata)
# POST /internal/scheduler/overdue-check (hourly)

# ML Cloud Run service URL.
ML_SERVICE_URL="https://<ml-service-url>"
ML_SERVICE_AUDIENCE="https://<ml-service-url>"
ML_TIMEOUT_MS="5000"

# SMTP delivery
SMTP_HOST="<smtp-host>"
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER="<secret-manager:smtp-user>"
SMTP_PASS="<secret-manager:smtp-password>"
EMAIL_FROM="HOPE Platform <noreply@<your-domain>>"

# Google Drive proof storage
GOOGLE_DRIVE_CLIENT_EMAIL="<service-account-email>"
GOOGLE_DRIVE_PRIVATE_KEY="<secret-manager:google-drive-private-key>"
GOOGLE_DRIVE_FOLDER_ID="<shared-drive-folder-id>"

WEEKLY_REPORT_ENABLED="false"
WEEKLY_REPORT_DAY="1"
WEEKLY_REPORT_HOUR="9"
WEEKLY_REPORT_TZ="Asia/Kolkata"
