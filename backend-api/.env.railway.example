# Required for API and worker; use the same shared values on both services.
NODE_ENV=production
PORT=8080
DATABASE_URL=<postgresql-connection-string>
JWT_SECRET=<strong-random-secret>
TOKEN_HASH_SECRET=<strong-random-secret>
REDIS_URL=<redis-connection-string>

# Optional during API-only startup. Set both after the frontend has a domain;
# CORS remains deny-by-default when FRONTEND_URLS is empty.
FRONTEND_URL=https://your-frontend-domain.up.railway.app
FRONTEND_URLS=https://your-frontend-domain.up.railway.app

# Private Railway service-to-service URL; set ML_SERVICE_AUTH_MODE=none only
# when the ML service has no public domain and uses Railway private networking.
ML_SERVICE_URL=http://${{ml-service.RAILWAY_PRIVATE_DOMAIN}}:${{ml-service.PORT}}
ML_SERVICE_AUTH_MODE=none
ML_TIMEOUT_MS=5000

SMTP_HOST=<smtp-host>
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=<smtp-user>
SMTP_PASS=<smtp-password>
EMAIL_FROM=<sender-address>
GOOGLE_DRIVE_CLIENT_EMAIL=<service-account-email>
GOOGLE_DRIVE_PRIVATE_KEY=<service-account-private-key>
GOOGLE_DRIVE_FOLDER_ID=<drive-folder-id>

# Worker service only: scheduled jobs may also be triggered externally.
WEEKLY_REPORT_ENABLED=false
WEEKLY_REPORT_TZ=Asia/Kolkata
