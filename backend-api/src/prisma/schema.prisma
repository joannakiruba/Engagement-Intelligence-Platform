generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserStatus {
  PENDING
  ACTIVE
  INACTIVE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
  EXCUSED
}

enum AssessmentType {
  CODING_TEST
  QUIZ
  ASSIGNMENT
  CONTEST
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
}

enum InterventionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum OutcomeType {
  IMPROVED
  NO_CHANGE
  DECLINED
}

enum NotificationType {
  RISK_ALERT
  EVENT_REMINDER
  INTERVENTION
  GENERAL
  TASK_UPDATE
  EVENT_UPDATE
}

enum ProofStatus {
  PENDING
  APPROVED
  REJECTED
}

enum FlagReason {
  IP_MISMATCH
  DEVICE_CONFLICT
  DEVICE_RESET
  MANUAL
}

enum FlagStatus {
  PENDING
  CONFIRMED_FRAUD
  DISMISSED
}

enum DeadlineType {
  FIXED
  TENTATIVE
  TBD
  NONE
}

enum TaskProgress {
  NOT_STARTED
  IN_PROGRESS
  ALMOST_COMPLETED
  COMPLETED
}

enum EventCategory {
  CODING
  HACKATHON
  OTHER
}

enum EventMode {
  ONLINE
  OFFLINE
}

enum EventRoundStatus {
  UPCOMING
  ONGOING
  DONE
}

enum RegistrationStatus {
  PENDING
  INTERESTED
  REGISTERED
  WITHDRAWN
}

model Role {
  id String @id @default(uuid())

  name String @unique

  description String?

  createdAt DateTime @default(now())

  users User[]

  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id String @id @default(uuid())

  code String @unique

  description String?

  createdAt DateTime @default(now())

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String
  permissionId String

  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id           String  @id @default(uuid())
  name         String
  email        String  @unique
  passwordHash String?
  phone        String?

  department String?
  year       Int?

  roleId String
  role   Role   @relation(fields: [roleId], references: [id])

  status UserStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  refreshTokens       RefreshToken[]
  activationTokens    AccountActivationToken[]
  passwordResetTokens PasswordResetToken[]

  batchMembers   BatchMember[]
  trainerBatches BatchTrainer[]

  attendances Attendance[]

  deviceTokens    DeviceToken[]
  attendanceFlags AttendanceFlag[]
  flagsReviewed   AttendanceFlag[] @relation("FlagReviewer")

  assessmentResults AssessmentResult[]

  studentQuestionScores StudentQuestionScore[]

  feedbackReceived Feedback[] @relation("StudentFeedback")
  feedbackGiven    Feedback[] @relation("TrainerFeedback")

  mentorAssignments  MentorAssignment[] @relation("MentorAssignments")
  studentAssignments MentorAssignment[] @relation("StudentAssignments")

  riskScores RiskScore[]

  interventionsAsStudent Intervention[] @relation("StudentInterventions")
  interventionsAsMentor  Intervention[] @relation("MentorInterventions")

  notifications Notification[]

  eventRegistrations EventRegistration[]
  proofSubmissions   ProofSubmission[]
  createdEvents      Event[]

  auditLogs AuditLog[]
  sessions  Session[]

  tasksCreated        Task[]               @relation("TaskCreator")
  taskSubmissions     TaskSubmission[]     @relation("TaskStudent")
  taskGrades          TaskSubmission[]     @relation("TaskGrader")
  taskDeadlineChanges TaskDeadlineChange[] @relation("DeadlineChanger")

  @@map("users")
}

model Batch {
  id String @id @default(uuid())

  name       String
  department String?

  startDate DateTime
  endDate   DateTime?

  description String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  members     BatchMember[]
  trainers    BatchTrainer[]
  sessions    Session[]
  assessments Assessment[]
  taskBatches TaskBatch[]
  eventBatches EventBatch[]

  @@map("batches")
}

model BatchMember {
  id String @id @default(uuid())

  batchId   String
  studentId String

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  joinedAt DateTime @default(now())

  @@unique([batchId, studentId])
  @@map("batch_members")
}

model BatchTrainer {
  id String @id @default(uuid())

  batchId   String
  trainerId String

  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  trainer User @relation(fields: [trainerId], references: [id], onDelete: Cascade)

  assignedAt DateTime @default(now())

  @@unique([batchId, trainerId])
  @@map("batch_trainers")
}

model Session {
  id String @id @default(uuid())

  batchId   String
  trainerId String

  title String
  topic String?

  scheduledDate DateTime

  startTime DateTime
  endTime   DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id])

  trainer User @relation(fields: [trainerId], references: [id])

  attendanceWindows AttendanceWindow[]
  attendances       Attendance[]
  feedbacks         Feedback[]

  @@index([batchId])
  @@map("sessions")
}

model AttendanceWindow {
  id String @id @default(uuid())

  sessionId String

  label String

  startTime DateTime
  endTime   DateTime

  trainerIp          String?
  networkFingerprint String?

  createdAt DateTime @default(now())

  session     Session      @relation(fields: [sessionId], references: [id])
  attendances Attendance[]

  @@map("attendance_windows")
}

model Attendance {
  id String @id @default(uuid())

  windowId  String
  sessionId String
  studentId String

  status AttendanceStatus

  checkInTime DateTime?

  studentIp          String?
  networkFingerprint String?
  deviceTokenId      String?

  remarks String?

  createdAt DateTime @default(now())

  window  AttendanceWindow @relation(fields: [windowId], references: [id])
  session Session          @relation(fields: [sessionId], references: [id])
  student User             @relation(fields: [studentId], references: [id])
  flags   AttendanceFlag[]

  @@unique([windowId, studentId])
  @@index([studentId])
  @@index([sessionId])
  @@map("attendance")
}

model DeviceToken {
  id String @id @default(uuid())

  tokenHash String @unique

  studentId String

  userAgent String?

  createdAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId])
  @@map("device_tokens")
}

model AttendanceFlag {
  id String @id @default(uuid())

  attendanceId String
  studentId    String

  reason  FlagReason
  details String?

  status     FlagStatus @default(PENDING)
  reviewedBy String?
  resolvedAt DateTime?

  createdAt DateTime @default(now())

  attendance Attendance @relation(fields: [attendanceId], references: [id], onDelete: Cascade)
  student    User       @relation(fields: [studentId], references: [id])
  reviewer   User?      @relation("FlagReviewer", fields: [reviewedBy], references: [id])

  @@index([studentId])
  @@index([status])
  @@map("attendance_flags")
}

model Assessment {
  id String @id @default(uuid())

  batchId String

  title String

  type AssessmentType

  maxScore Float

  assessmentDate DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  batch Batch @relation(fields: [batchId], references: [id])

  results AssessmentResult[]

  sections AssessmentSection[]

  @@index([batchId])
  @@map("assessments")
}

model AssessmentResult {
  id String @id @default(uuid())

  assessmentId String
  studentId    String

  score Float

  remarks String?

  createdAt DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id])

  student User @relation(fields: [studentId], references: [id])

  @@unique([assessmentId, studentId])
  @@map("assessment_results")
}

model AssessmentSection {
  id String @id @default(uuid())

  assessmentId String

  title String

  sortOrder Int @default(0)

  weightage Float?

  createdAt DateTime @default(now())

  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  questions AssessmentQuestion[]

  @@map("assessment_sections")
}

model AssessmentQuestion {
  id String @id @default(uuid())

  sectionId String

  label String

  maxScore Float

  sortOrder Int @default(0)

  createdAt DateTime @default(now())

  section AssessmentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)

  studentScores StudentQuestionScore[]

  @@map("assessment_questions")
}

model StudentQuestionScore {
  id String @id @default(uuid())

  questionId String
  studentId  String

  score Float

  createdAt DateTime @default(now())

  question AssessmentQuestion @relation(fields: [questionId], references: [id], onDelete: Cascade)

  student User @relation(fields: [studentId], references: [id], onDelete: Restrict)

  @@unique([questionId, studentId])
  @@map("student_question_scores")
}

model Feedback {
  id String @id @default(uuid())

  sessionId String
  studentId String
  trainerId String

  effortRating        Int
  participationRating Int

  comments String?

  createdAt DateTime @default(now())

  session Session @relation(fields: [sessionId], references: [id])

  student User @relation("StudentFeedback", fields: [studentId], references: [id])

  trainer User @relation("TrainerFeedback", fields: [trainerId], references: [id])

  @@unique([sessionId, studentId])
  @@index([studentId])
  @@index([sessionId])
  @@map("feedback")
}

model MentorAssignment {
  id String @id @default(uuid())

  mentorId  String
  studentId String

  mentor User @relation("MentorAssignments", fields: [mentorId], references: [id])

  student User @relation("StudentAssignments", fields: [studentId], references: [id])

  assignedAt DateTime @default(now())

  @@unique([mentorId, studentId])
  @@map("mentor_assignments")
}

model RiskScore {
  id String @id @default(uuid())

  studentId String

  attendanceRisk Float
  assessmentRisk Float
  feedbackRisk   Float

  totalScore Float

  riskLevel RiskLevel

  factors Json?

  generatedAt DateTime @default(now())

  student User @relation(fields: [studentId], references: [id])

  interventions Intervention[]

  @@index([studentId])
  @@map("risk_scores")
}

model Intervention {
  id String @id @default(uuid())

  studentId String
  mentorId  String

  riskScoreId String?

  causeCode String?

  alertId Int?

  title       String
  description String

  status InterventionStatus @default(PENDING)

  deadline DateTime?

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User @relation("StudentInterventions", fields: [studentId], references: [id])

  mentor User @relation("MentorInterventions", fields: [mentorId], references: [id])

  riskScore RiskScore? @relation(fields: [riskScoreId], references: [id])

  updates InterventionUpdate[]

  outcome InterventionOutcome?

  tasks InterventionTask[]

  @@index([studentId])
  @@index([mentorId])
  @@map("interventions")
}

model InterventionUpdate {
  id String @id @default(uuid())

  interventionId String

  note String

  editedAt DateTime?

  createdAt DateTime @default(now())

  intervention Intervention @relation(fields: [interventionId], references: [id])

  @@map("intervention_updates")
}

model InterventionTask {
  id String @id @default(uuid())

  interventionId String

  title       String
  description String?

  deadline DateTime?

  isCompleted Boolean @default(false)

  completedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  intervention Intervention @relation(fields: [interventionId], references: [id])

  @@map("intervention_tasks")
}

model InterventionOutcome {
  id String @id @default(uuid())

  interventionId String @unique

  outcome OutcomeType

  remarks String?

  recordedAt DateTime @default(now())

  intervention Intervention @relation(fields: [interventionId], references: [id])

  @@map("intervention_outcomes")
}

model Notification {
  id String @id @default(uuid())

  userId String

  title   String
  message String

  type NotificationType

  isRead Boolean @default(false)

  referenceId   String?
  referenceType String?

  deduplicationKey String?

  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([deduplicationKey])
  @@index([userId])
  @@map("notifications")
}

model EventType {
  id String @id @default(uuid())

  name        String @unique
  description String?

  createdAt DateTime @default(now())

  @@map("event_types")
}

model Event {
  id String @id @default(uuid())

  title       String
  description String?

  category    EventCategory @default(OTHER)
  isMandatory Boolean       @default(false)

  officialLink String?
  startDate    DateTime?
  endDate      DateTime?
  mode         EventMode?
  venue        String?
  fee          Float?

  closedAt DateTime?

  createdById String
  createdBy   User @relation(fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  eventBatches  EventBatch[]
  rounds        EventRound[]
  registrations EventRegistration[]

  proofSubmissions ProofSubmission[]

  @@map("events")
}

model EventBatch {
  eventId String
  batchId String
  @@map("event_batches")

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@id([eventId, batchId])
}

model EventRound {
  id String @id @default(uuid())
  @@map("event_rounds")

  eventId String

  name String

  roundDate DateTime?
  deadline  DateTime?

  status EventRoundStatus @default(UPCOMING)

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@index([eventId])
}

model EventRegistration {
  id String @id @default(uuid())

  eventId   String
  studentId String

  status RegistrationStatus @default(PENDING)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  student User @relation(fields: [studentId], references: [id])

  @@unique([eventId, studentId])
  @@map("event_registrations")
}

model ProofSubmission {
  id String @id @default(uuid())

  eventId   String
  studentId String

  fileUrl String

  fileName String

  status ProofStatus @default(PENDING)

  remarks String?

  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id])

  student User @relation(fields: [studentId], references: [id])

  @@unique([eventId, studentId])
  @@map("proof_submissions")
}

model RefreshToken {
  id String @id @default(uuid())

  tokenHash String @unique

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  familyId        String
  familyCreatedAt DateTime

  expiresAt DateTime

  revokedAt DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model AccountActivationToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("account_activation_tokens")
}

model PasswordResetToken {
  id String @id @default(uuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  tokenHash String @unique

  expiresAt DateTime
  usedAt    DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

model AuditLog {
  id String @id @default(uuid())

  userId String?

  entityType String

  entityId String

  action String

  oldValues Json?

  newValues Json?

  ipAddress String?

  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}

model Task {
  id String @id @default(uuid())

  title       String
  description String?

  isMandatory Boolean @default(true)
  isInternal  Boolean @default(false)
  maxMarks    Float?

  deadlineType DeadlineType @default(NONE)
  deadline     DateTime?
  deadlineNote String?

  closedAt DateTime?

  createdById String
  createdBy   User   @relation("TaskCreator", fields: [createdById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  taskBatches     TaskBatch[]
  submissions     TaskSubmission[]
  deadlineChanges TaskDeadlineChange[]

  @@map("tasks")
}

model TaskBatch {
  id String @id @default(uuid())

  taskId  String
  batchId String

  task  Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  batch Batch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([taskId, batchId])
  @@map("task_batches")
}

model TaskSubmission {
  id String @id @default(uuid())

  taskId    String
  studentId String

  progress TaskProgress @default(NOT_STARTED)

  isInterested Boolean @default(false)

  completedAt DateTime?
  isLate      Boolean?

  marksAwarded Float?
  gradedById   String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  task     Task  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  student  User  @relation("TaskStudent", fields: [studentId], references: [id])
  gradedBy User? @relation("TaskGrader", fields: [gradedById], references: [id])

  @@unique([taskId, studentId], name: "taskId_studentId")
  @@map("task_submissions")
}

model TaskDeadlineChange {
  id String @id @default(uuid())

  taskId String

  oldDeadlineType DeadlineType
  newDeadlineType DeadlineType

  oldDeadline DateTime?
  newDeadline DateTime?

  reason String?

  changedById String
  changedBy   User   @relation("DeadlineChanger", fields: [changedById], references: [id])

  createdAt DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)

  @@map("task_deadline_changes")
}

model MlMentorAlert {
  id Int @id @default(autoincrement())

  studentId String  @map("student_id")
  mentorId  String  @map("mentor_id")
  batchId   String? @map("batch_id")

  priorityScore Float  @map("priority_score")
  urgencyTier   String @map("urgency_tier")
  triggerReason String @map("trigger_reason")
  riskScore     Float  @map("risk_score")
  riskVelocity  Float? @map("risk_velocity")

  recommendedIntervention  String? @map("recommended_intervention")
  recommendationConfidence Float?  @map("recommendation_confidence")
  recommendationReasoning  String? @map("recommendation_reasoning")

  alertStatus String @default("pending") @map("alert_status")

  createdAt DateTime  @default(now()) @map("created_at")
  seenAt    DateTime? @map("seen_at")
  actedAt   DateTime? @map("acted_at")

  outcomes MlAlertOutcome[]

  @@index([studentId])
  @@index([mentorId])
  @@index([batchId])
  @@index([urgencyTier])
  @@index([alertStatus])
  @@index([createdAt])
  @@map("ml_mentor_alerts")
}

model MlAlertOutcome {
  id Int @id @default(autoincrement())

  alertId Int @map("alert_id")

  mentorResponse    String? @map("mentor_response")
  responseTimeHours Float?  @map("response_time_hours")
  interventionId    String? @map("intervention_id")

  studentRiskAfter7d  Float? @map("student_risk_after_7d")
  studentRiskAfter14d Float? @map("student_risk_after_14d")

  wasRecommendationFollowed Boolean? @default(false) @map("was_recommendation_followed")
  outcomeNotes              String?  @map("outcome_notes")

  createdAt DateTime @default(now()) @map("created_at")

  alert MlMentorAlert @relation(fields: [alertId], references: [id], onDelete: Cascade)

  @@index([alertId])
  @@map("ml_alert_outcomes")
}
