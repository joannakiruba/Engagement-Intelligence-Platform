# Database
DATABASE_URL="postgresql://user:password@localhost:55432/hope_platform?schema=public"

# JWT
JWT_SECRET="change-me-to-a-strong-random-secret-at-least-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY_DAYS="7"
JWT_REFRESH_ABSOLUTE_CEILING_DAYS="30"
JWT_REFRESH_GRACE_WINDOW_SECONDS="10"

# Token hashing
TOKEN_HASH_SECRET="change-me-to-a-different-strong-random-secret"

# Server
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Seed (development only — must satisfy password policy: 12+ chars)
SEED_TEST_PASSWORD=""

# Redis / BullMQ
REDIS_HOST="localhost"
REDIS_PORT="56379"
REDIS_PASSWORD=""
REDIS_DB="0"

# SMTP / Nodemailer
SMTP_HOST=""
SMTP_PORT="587"
SMTP_SECURE="false"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="HOPE Platform <noreply@example.com>"


# Google Drive (Proof Submissions)
GOOGLE_DRIVE_CLIENT_EMAIL="your-service-account@project.iam.gserviceaccount.com"
GOOGLE_DRIVE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
GOOGLE_DRIVE_FOLDER_ID="your-shared-drive-folder-id"

# Enable delivery only after SMTP and recipients are configured.
WEEKLY_REPORT_ENABLED=false
WEEKLY_REPORT_DAY=1
WEEKLY_REPORT_HOUR=9
WEEKLY_REPORT_TZ="Asia/Kolkata"
ML_SERVICE_URL="http://localhost:8000"
