# Database
DATABASE_URL="postgresql://user:password@localhost:5432/hope_platform?schema=public"

# JWT
JWT_SECRET="change-me-to-a-strong-random-secret-at-least-32-chars"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY_DAYS="7"
JWT_REFRESH_ABSOLUTE_CEILING_DAYS="30"
JWT_REFRESH_GRACE_WINDOW_SECONDS="10"

# Token hashing
TOKEN_HASH_SECRET="change-me-to-a-different-strong-random-secret"

# Server
PORT=3000
NODE_ENV="development"
FRONTEND_URL="http://localhost:5173"

# Seed (development only — must satisfy password policy: 12+ chars)
SEED_TEST_PASSWORD="HopeTest2026!@dev"
